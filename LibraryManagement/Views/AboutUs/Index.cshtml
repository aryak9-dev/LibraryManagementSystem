@{
    ViewData["Title"] = "About Us";
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-body p-5">

            <h2 class="fw-bold mb-4">
                About Us
            </h2>

            <p class="lead text-muted">
                Welcome to Library Management, your ultimate portal for
                digital and physical resource tracking.
            </p>

            <p>
                Our mission is to simplify school and university catalog
                management by providing a fast, secure and easy-to-use
                platform for students, librarians and administrators.
            </p>

            <div class="row mt-5">

                <div class="col-md-4">

                    <h4>Our Vision</h4>

                    <p>
                        To build connected learning environments where
                        academic resources are available to everyone.
                    </p>

                </div>

                <div class="col-md-4">

                    <h4>Smart Tracking</h4>

                    <p>
                        Track available books, borrowed books,
                        return dates and inventory in real time.
                    </p>

                </div>

                <div class="col-md-4">

                    <h4>Easy Access</h4>

                    <p>
                        Responsive interface designed for desktop,
                        tablet and mobile devices.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>