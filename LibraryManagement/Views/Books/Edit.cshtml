@model LibraryManagement.Models.Book

<h2>Edit Book</h2>

<form asp-action="Edit">

    <input type="hidden" asp-for="BookId"/>

    <div class="mb-3">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="Author"></label>
        <input asp-for="Author" class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="ISBN"></label>
        <input asp-for="ISBN" class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="PublishedDate"></label>
        <input asp-for="PublishedDate" class="form-control"/>
    </div>
        <div class="mb-3">
        <label asp-for="TotalCopies" class="form-label"></label>
        <input asp-for="TotalCopies" class="form-control" min="1" />
        <span asp-validation-for="TotalCopies" class="text-danger"></span>
    </div>

    <!-- <div class="mb-3">
        <label asp-for="AvailableCopies" class="form-label"></label>
        <input asp-for="AvailableCopies" class="form-control" />
        <span asp-validation-for="AvailableCopies" class="text-danger"></span>
    </div> -->

    <button class="btn btn-warning">Update</button>

</form>
