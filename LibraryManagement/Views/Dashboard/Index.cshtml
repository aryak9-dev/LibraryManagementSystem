@model LibraryManagement.Models.DashboardModel

@{
    ViewData["Title"] = "Dashboard";

    int totalInventory = Model.AvailableBooks + Model.BorrowedBooks;

    int availablePercent = totalInventory == 0
        ? 0
        : (int)Math.Round((double)Model.AvailableBooks * 100 / totalInventory);

    int borrowedPercent = totalInventory == 0
        ? 0
        : (int)Math.Round((double)Model.BorrowedBooks * 100 / totalInventory);
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">📚 Library Dashboard</h2>
            <p class="text-muted">
                Welcome back,
                <strong>@Context.Session.GetString("Username")</strong>
            </p>
        </div>

        <div class="text-end">
            <h6>@DateTime.Now.ToString("dddd")</h6>
            <small>@DateTime.Now.ToString("dd MMM yyyy")</small>
        </div>
    </div>

    <!-- Statistics -->

    <div class="row g-3">

        <div class="col-lg-3 col-md-6">
            <div class="card shadow border-0 bg-primary text-white">
                <div class="card-body text-center">
                    <h5>Total Books</h5>
                    <h2>@Model.TotalBooks</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow border-0 bg-success text-white">
                <div class="card-body text-center">
                    <h5>Students</h5>
                    <h2>@Model.TotalStudents</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow border-0 bg-warning text-dark">
                <div class="card-body text-center">
                    <h5>Librarians</h5>
                    <h2>@Model.TotalLibrarians</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow border-0 bg-dark text-white">
                <div class="card-body text-center">
                    <h5>Publications</h5>
                    <h2>@Model.TotalPublications</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-danger shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-danger">Out of Stock</h6>
                    <h2>@Model.OutOfStockBooks</h2>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-warning">Low Stock</h6>
                    <h2>@Model.LowStockBooks</h2>
                </div>
            </div>
        </div>

    </div>

    <br />

    <!-- Inventory -->

    <div class="row g-3">

        <div class="col-lg-3 col-md-6">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h5>Available Books</h5>
                    <h2 class="text-success">@Model.AvailableBooks</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h5>Borrowed Books</h5>
                    <h2 class="text-danger">@Model.BorrowedBooks</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h5>Magazines</h5>
                    <h2>@Model.TotalMagazines</h2>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h5>Newspapers</h5>
                    <h2>@Model.TotalNewspapers</h2>
                </div>
            </div>
        </div>

    </div>

    <hr class="my-4"/>

    <div class="row">

        <!-- Recent Borrow Records -->

        <div class="col-lg-8">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Recent Borrow Records</h5>
                </div>

                <div class="card-body">

                    <table class="table table-hover">

                        <thead>

                            <tr>
                                <th>Borrower</th>
                                <th>Book</th>
                                <th>Borrow Date</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                        @foreach (var item in Model.RecentBorrows)
                        {
                            <tr>

                                <td>@item.BorrowerName</td>

                                <td>@item.Book?.Title</td>

                                <td>@item.BorrowDate.ToString("dd MMM yyyy")</td>

                                <td>

                                    @if(item.ReturnDate == null)
                                    {
                                        <span class="badge bg-danger">
                                            Borrowed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Returned
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- low stck alert -->
        
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">⚠ Low Stock Books</h5>
            </div>
        
            <div class="card-body">
        
                @if (Model.LowStockBookList.Any())
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Book</th>
                                <th>Author</th>
                                <th>Available Copies</th>
                            </tr>
                        </thead>
        
                        <tbody>
        
                        @foreach(var book in Model.LowStockBookList)
                        {
                            <tr>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>
                            <span class="badge bg-warning">
                                @book.AvailableCopies Left
                            </span>
                        </td>
                            </tr>
                        }
        
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-success mb-0">
                ✔ No books are currently low in stock.
                    </p>
                }
        
            </div>
        </div>










        <!-- Quick Actions -->

        <div class="col-lg-4">

            <div class="card shadow">

                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>

                <div class="card-body d-grid gap-2">

                    <a asp-controller="Books"
                       asp-action="Create"
                       class="btn btn-primary">
                        + Add Book
                    </a>

                    <a asp-controller="Student"
                       asp-action="Create"
                       class="btn btn-success">
                        + Add Student
                    </a>

                    <a asp-controller="Librarian"
                       asp-action="Create"
                       class="btn btn-warning">
                        + Add Librarian
                    </a>

                    <a asp-controller="Publication"
                       asp-action="Create"
                       class="btn btn-dark">
                        + Add Publication
                    </a>

                    <a asp-controller="Books"
                       asp-action="Index"
                       class="btn btn-danger">
                        Borrow Book
                    </a>

                </div>

            </div>

            <br />

            <div class="card shadow">

                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Inventory Status</h5>
                </div>

                <div class="card-body">

                    <p>Available Books</p>

                    <div class="progress mb-3">

                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width:@availablePercent%">
                            @availablePercent%
                        </div>

                    </div>

                    <p>Borrowed Books</p>

                    <div class="progress">

                        <div class="progress-bar bg-danger"
                             role="progressbar"
                             style="width:@borrowedPercent%">
                            @borrowedPercent%
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <hr class="my-4"/>

    <!-- Recent Publications -->

    <div class="card shadow">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Recent Publications</h5>
        </div>

        <div class="card-body">

            <table class="table table-striped">

                <thead>

                    <tr>

                        <th>Title</th>
                        <th>Publisher</th>
                        <th>Type</th>
                        <th>Date</th>

                    </tr>

                </thead>

                <tbody>

                @foreach(var item in Model.RecentPublications)
                {
                    <tr>

                        <td>@item.Title</td>

                        <td>@item.Publisher</td>

                        <td>@item.Type</td>

                        <td>@item.PublishedDate.ToString("dd MMM yyyy")</td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>