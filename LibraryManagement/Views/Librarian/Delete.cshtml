@model LibraryManagement.Models.LibrarianModel

@{
    ViewData["Title"] = "Delete Librarian";
}

<h2>Delete Librarian</h2>

<h4 class="text-danger">
    Are you sure you want to delete this librarian?
</h4>

<hr/>

<dl class="row">

    <dt class="col-sm-2">
        Name
    </dt>

    <dd class="col-sm-10">
        @Model.Name
    </dd>

    <dt class="col-sm-2">
        Age
    </dt>

    <dd class="col-sm-10">
        @Model.Age
    </dd>

    <dt class="col-sm-2">
        Phone
    </dt>

    <dd class="col-sm-10">
        @Model.Phone
    </dd>

</dl>

<form asp-action="Delete">

    <input type="hidden" asp-for="LibrarianId"/>

    <button class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>