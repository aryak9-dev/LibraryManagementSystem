@using LibraryManagement.Models
@model Publication

@{
    ViewData["Title"] = "Delete Publication";
}

<div class="container mt-4">

    <div class="card border-danger shadow">

        <div class="card-header bg-danger text-white">
            <h3>Delete Publication</h3>
        </div>

        <div class="card-body">

            <h5 class="text-danger">
                Are you sure you want to delete this publication?
            </h5>

            <hr />

            <dl class="row">

                <dt class="col-sm-4">
                    Title
                </dt>

                <dd class="col-sm-8">
                    @Model.Title
                </dd>

                <dt class="col-sm-4">
                    Publisher
                </dt>

                <dd class="col-sm-8">
                    @Model.Publisher
                </dd>

                <dt class="col-sm-4">
                    Type
                </dt>

                <dd class="col-sm-8">

                    @if (Model.Type == PublicationType.Magazine)
                    {
                        <span class="badge bg-success">
                            Magazine
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-primary">
                            Newspaper
                        </span>
                    }

                </dd>

                <dt class="col-sm-4">
                    Published Date
                </dt>

                <dd class="col-sm-8">
                    @Model.PublishedDate.ToShortDateString()
                </dd>

                <dt class="col-sm-4">
                    Total Copies
                </dt>

                <dd class="col-sm-8">
                    @Model.TotalCopies
                </dd>

                <dt class="col-sm-4">
                    Available Copies
                </dt>

                <dd class="col-sm-8">
                    @Model.AvailableCopies
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="PublicationId" />

                <button type="submit"
                        class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>