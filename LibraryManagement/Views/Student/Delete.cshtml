@model LibraryManagement.Models.StudentModel

@{
    ViewData["Title"] = "Delete Student";
}

<h2>Delete Student</h2>

<h4 class="text-danger">
    Are you sure you want to delete this student?
</h4>

<hr />

<dl class="row">

    <dt class="col-sm-2">
        Name
    </dt>

    <dd class="col-sm-10">
        @Model.StudentName
    </dd>

    <dt class="col-sm-2">
        Email
    </dt>

    <dd class="col-sm-10">
        @Model.Email
    </dd>

    <dt class="col-sm-2">
        Phone
    </dt>

    <dd class="col-sm-10">
        @Model.Phone
    </dd>

</dl>

<form asp-action="Delete">

    <input type="hidden" asp-for="StudentId" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>